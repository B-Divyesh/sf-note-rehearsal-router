{
  "name": "note-rehearsal-router",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:site": "vite --config site/vite.config.ts",
    "build:extension": "wxt build",
    "build:site": "vite build --config site/vite.config.ts",
    "package:extension": "node scripts/package-extension.mjs",
    "build": "npm run build:extension && npm run build:site && npm run package:extension",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/lora": "5.2.8"
  },
  "devDependencies": {
    "@types/chrome": "0.1.4",
    "fflate": "0.8.2",
    "jsdom": "26.1.0",
    "sharp-cli": "^6.0.0",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4",
    "wxt": "0.21.4"
  }
}
